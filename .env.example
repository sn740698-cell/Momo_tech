# MOMO Environment Configuration

DEBUG=True
DJANGO_SECRET_KEY=momo-secret-key-change-in-production

# Local Generative LLM (Ollama - Llama exclusively)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/hugging-quants/Llama-3.2-1B-Instruct-Q8_0-GGUF:Q8_0
OLLAMA_TIMEOUT=90
LANGGRAPH_TIMEOUT=90

# Sentence-level Contextual Analysis & Embeddings
BERT_MODEL=bert-base-uncased
DISTILBERT_MODEL=distilbert-base-uncased

# Speech Recognition & Speech Synthesis
STT_MODEL=base
TTS_MODEL=en_US-lessac-medium

# Acceleration & Device
DEVICE=cuda

# Privacy & Sensor Permissions (Strict Local-First Control)
CAMERA_ENABLED=false
MICROPHONE_ENABLED=false
MEMORY_ENABLED=true
ACTIVITY_TRACKING_ENABLED=false

# Physical Companion Hardware (ESP32)
MOMO_DEVICE_ID=momo-01
SERIAL_PORT=AUTO
SERIAL_BAUD=115200

# Multi-Agent RAG & Workflow Subsystem
AI_MOCK_MODE=false
LLM_PROVIDER=ollama
LLM_MODEL=hf.co/hugging-quants/Llama-3.2-1B-Instruct-Q8_0-GGUF:Q8_0
LLM_SOLVER_A_PROVIDER=ollama
LLM_SOLVER_B_PROVIDER=ollama
LLM_EVALUATOR_PROVIDER=ollama
EMBEDDING_PROVIDER=distilbert
MAX_RETRIES=2
AI_WORKFLOW_TIMEOUT=90
